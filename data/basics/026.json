{
  "id": 26,
  "title": "Ghép tất cả lại & học tiếp gì",
  "teaches": [
    "is",
    "are",
    "was",
    "were",
    "am",
    "don't",
    "doesn't",
    "can",
    "can't",
    "there",
    "works",
    "lives",
    "goes",
    "studies",
    "has",
    "my",
    "her",
    "his",
    "their",
    "Nam",
    "Lan",
    "Hue",
    "English",
    "Monday",
    "Sunday",
    "o'clock",
    "past",
    "at",
    "in",
