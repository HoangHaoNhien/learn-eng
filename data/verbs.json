    { "wrong": "I <b>layed</b> on the sofa all afternoon.", "right": "I <b>lay</b> on the sofa all afternoon.", "why": "<i>layed</i> không tồn tại. Quá khứ của <b>lie</b> (nằm) chính là <b>lay</b> — trùng mặt chữ với nguyên thể của động từ kia." },
    { "wrong": "I <b>laid</b> down for a nap.", "right": "I <b>lay</b> down for a nap.", "why": "<b>lay</b> cần tân ngữ (<i>lay the book down</i>). Tự mình nằm xuống thì dùng <b>lie – lay – lain</b>." },
    { "wrong": "Prices have <b>raised</b> this year.", "right": "Prices have <b>risen</b> this year.", "why": "Giá tự tăng, không ai nâng nó, nên dùng <b>rise</b>. <i>raise</i> phải có tân ngữ: <i>They raised prices.</i>" },
    { "wrong": "I have <b>fell</b> down twice.", "right": "I have <b>fallen</b> down twice.", "why": "Sau <i>have</i> là V3. <b>fell</b> là V2, mà cũng dễ lẫn với <b>felt</b> (cảm thấy)." },
    { "wrong": "The company was <b>found</b> in 1990.", "right": "The company was <b>founded</b> in 1990.", "why": "<b>found</b> (thành lập) là động từ CÓ quy tắc. Nó chỉ trùng mặt chữ với V2 của <i>find</i>." },
    { "wrong": "He <b>hanged</b> the picture on the wall.", "right": "He <b>hung</b> the picture on the wall.", "why": "<b>hanged</b> chỉ dùng cho nghĩa treo cổ người. Treo đồ vật là <b>hung</b>." },
    { "wrong": "I have <b>went</b> there before.", "right": "I have <b>been</b> there before.", "why": "Sau <i>have</i> phải là V3. Và <b>been</b> = đã đi rồi về, <b>gone</b> = đi rồi chưa về." },
    { "wrong": "I have <b>saw</b> that film.", "right": "I have <b>seen</b> that film.", "why": "<b>saw</b> là V2. Sau <i>have</i> luôn là V3 — <b>seen</b>." },
    { "wrong": "The letter was <b>wrote</b> by him.", "right": "The letter was <b>written</b> by him.", "why": "Câu bị động dùng <b>be + V3</b>, không bao giờ dùng V2. Xem [Ngữ pháp 46]." },
    { "wrong": "<b>Did</b> you <b>saw</b> him?", "right": "<b>Did</b> you <b>see</b> him?", "why": "Đã mượn <i>did</i> thì động từ chính về dạng TRẦN. Thì nằm ở trợ động từ, không nằm hai chỗ. Xem [Ngữ pháp 44]." },
    { "wrong": "I <b>cutted</b> the paper.", "right": "I <b>cut</b> the paper.", "why": "Nhóm A-A-A không đổi gì cả — chính vì thế rất dễ quên rằng chúng bất quy tắc." },
